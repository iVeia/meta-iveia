bootenv_addr=0x600000
bootenv_file=uEnv.txt
iv_boot_targets=mmc0 mmc1 dhcp
loadenv_mmc0=load mmc 0 ${bootenv_addr} ${altpath}/${bootenv_file}
loadenv_mmc1=load mmc 1 ${bootenv_addr} ${altpath}/${bootenv_file}
autoload=no
ethprime=eth3
loadenv_dhcp=dhcp && tftpboot ${bootenv_addr} ${altpath}/${bootenv_file}
jtag_boot_magic=4a544147
loadenv_jtag=
    setexpr scratch_addr  ${bootenv_addr} - 0x10;
    setexpr magic_addr    ${bootenv_addr} - 0x0c; setexpr.l magic *${magic_addr};
    setexpr filesize_addr ${bootenv_addr} - 0x08; setexpr.l fsize *${filesize_addr};
    setexpr crc32_addr    ${bootenv_addr} - 0x04; setexpr.l crc32 *${crc32_addr};
    mw.l ${scratch_addr} 0 4;
    setenv filesize 0;
    if test ${magic} = ${jtag_boot_magic}; then
        crc32 ${bootenv_addr} ${fsize} ${scratch_addr};
        setexpr crc32_calc *${scratch_addr};
        if test ${crc32} = ${crc32_calc}; then
            setenv filesize ${fsize};
        fi;
    fi
importenv=env import -t ${bootenv_addr} ${filesize}
load_mmc0=setenv tgt mmc0; run loadtgt
load_mmc1=setenv tgt mmc1; run loadtgt
load_dhcp=setenv tgt dhcp; run loadtgt
load_jtag=setenv tgt jtag; run loadtgt
loadtgt=
    if run loadenv_${tgt}; then
        run importenv;
        setenv loadmode ${tgt};
    fi
zynq_forced_jtag_magic_addr=0x500000
zynq_test_forced_jtag=
    setexpr.l magic *${zynq_forced_jtag_magic_addr};
    if test ${board} = zynq -a ${magic} = ${jtag_boot_magic}; then
        mw.l ${zynq_forced_jtag_magic_addr} 0;
        echo JTAG Magic found - forcing JTAG boot;
        setenv modeboot jtagboot;
    fi
pauseboot=setenv pauseboot_on 1; boot
iv_boot_sequencer=
    run zynq_test_forced_jtag;
    if test ${modeboot} = jtagboot; then
        setenv iv_boot_targets jtag ${iv_boot_targets};
    fi;
    setenv break;
    echo Running boot sequence: ${iv_boot_targets};
    for tgt in ${iv_boot_targets}; do
        if test -z "${break}"; then
            echo Attempting load of ${altpath}/${bootenv_file} from ${tgt}...;
            run loadtgt;
            if test -n "${bootenv_cmd}"; then
                run bootenv_cmd;
                if test -n "${pauseboot_on}"; then
                    echo Pausing boot.;
                    setenv break 1;
                fi;
            fi;
        fi;
    done;
    echo No boot images found.  Aborting to prompt...
